APP_SERVICE_ORIGIN=http://localhost:8091
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Development only — stamps x-domain-code (CSR + SSR). Leave empty in production.
NEXT_PUBLIC_DEV_DOMAIN_CODE=pipgroupholding
NEXT_REVALIDATE_SECONDS=300
# Shared secret the backend sends as x-revalidate-secret to POST /api/revalidate
REVALIDATE_SECRET=nxqVp7Z+HdlcTQnxPoO4NoweQFtDQiwm8EWytMJAXcE=

# Cache windows (seconds) — short in dev so edits show up fast
NEXT_CONTENT_REVALIDATE_SECONDS=60
NEXT_BLOG_REVALIDATE_SECONDS=60
NEXT_BROWSER_CACHE_SECONDS=0
NEXT_BROWSER_STALE_SECONDS=0

# --- SEO / Analytics (public site) — leave empty in local unless testing integrations ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_AHREFS_ANALYTICS_KEY=
