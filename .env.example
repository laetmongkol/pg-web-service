APP_SERVICE_ORIGIN=
NEXT_PUBLIC_APP_URL=
# Development only (e.g. gocprime | morrocprime). Leave empty in production.
NEXT_PUBLIC_DEV_DOMAIN_CODE=
NEXT_REVALIDATE_SECONDS=
# Shared secret the backend sends as x-revalidate-secret to POST /api/revalidate (on-demand sitemap/blog cache busting)
REVALIDATE_SECRET=

# Cache windows (seconds) — tune per deploy, blank falls back to code defaults in server-cache.ts
# Next data cache: content pages (default 3600), blog surfaces (default 1800)
NEXT_CONTENT_REVALIDATE_SECONDS=
NEXT_BLOG_REVALIDATE_SECONDS=
# CDN s-maxage for the AI-facing files — llms.txt + the .md twin of each article (default 3600 = 1h)
# NOT tag-purgeable: a publish cannot clear the CDN copy. Set 0 to disable and follow the windows above.
NEXT_LLMS_REVALIDATE_SECONDS=
# Browser Cache-Control for public pages (defaults 300 / 3600)
NEXT_BROWSER_CACHE_SECONDS=
NEXT_BROWSER_STALE_SECONDS=

# --- SEO / Analytics (public site) — all optional; leave empty to disable that integration ---
# GA4 Measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Google Ads conversion ID, e.g. AW-XXXXXXXXX (production only)
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Google Search Console HTML-tag verification (the content="..." token only, not the whole <meta> tag)
NEXT_PUBLIC_GSC_VERIFICATION=
# Ahrefs Web Analytics data-key (the data-key value from the analytics.ahrefs.com snippet)
NEXT_PUBLIC_AHREFS_ANALYTICS_KEY=
